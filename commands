};const {
  SlashCommandBuilder,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
  StringSelectMenuBuilder,
  PermissionFlagsBits,
  ChannelType,
} = require('discord.js');

module.exports = {
  data: new SlashCommandBuilder()
    .setName('ticket')
    .setDescription('إرسال لوحة فتح التذاكر')
    .setDefaultMemberPermissions(PermissionFlagsBits.Administrator),

  async execute(interaction) {
    const embed = new EmbedBuilder()
      .setColor(0x5865F2)
      .setTitle('🎫 نظام الدعم الفني')
      .setDescription(
        '**أهلاً بك في مركز الدعم!**\n\n' +
        '> اختر نوع التذكرة من القائمة بالأسفل وسيتم إنشاء قناة خاصة بك مع فريق الدعم.\n\n' +
        '🟢 **متاح الآن** • ⏱️ متوسط الرد: 5 دقائق'
      )
      .setThumbnail(interaction.guild.iconURL({ dynamic: true }))
      .setFooter({ text: interaction.guild.name, iconURL: interaction.guild.iconURL() })
      .setTimestamp();

    const menu = new StringSelectMenuBuilder()
      .setCustomId('ticket_menu')
      .setPlaceholder('🔽 اختر نوع التذكرة...')
      .addOptions([
        { label: 'دعم عام', description: 'استفسارات أو مساعدة عامة', value: 'general', emoji: '💬' },
        { label: 'مشكلة تقنية', description: 'الإبلاغ عن مشكلة أو خطأ', value: 'bug', emoji: '🐛' },
        { label: 'شكوى', description: 'تقديم شكوى ضد عضو', value: 'report', emoji: '🚨' },
        { label: 'شراكة', description: 'طلب شراكة أو تعاون', value: 'partner', emoji: '🤝' },
      ]);

    await interaction.channel.send({
      embeds: [embed],
      components: [new ActionRowBuilder().addComponents(menu)],
    });
    await interaction.reply({ content: '✅ تم إرسال اللوحة', ephemeral: true });
  },

  async handleInteraction(interaction) {
    if (interaction.isStringSelectMenu() && interaction.customId === 'ticket_menu') {
      const type = interaction.values[0];
      const labels = { general: 'دعم-عام', bug: 'مشكلة', report: 'شكوى', partner: 'شراكة' };

      const existing = interaction.guild.channels.cache.find(
        c => c.name === `ticket-${interaction.user.username.toLowerCase()}`
      );
      if (existing) {
        return interaction.reply({ content: `❌ لديك تذكرة مفتوحة بالفعل: ${existing}`, ephemeral: true });
      }

      const channel = await interaction.guild.channels.create({
        name: `ticket-${interaction.user.username}`,
        type: ChannelType.GuildText,
        topic: `تذكرة | ${labels[type]} | ${interaction.user.id}`,
        permissionOverwrites: [
          { id: interaction.guild.id, deny: [PermissionFlagsBits.ViewChannel] },
          {
            id: interaction.user.id,
            allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.AttachFiles],
          },
        ],
      });

      const welcome = new EmbedBuilder()
        .setColor(0x57F287)
        .setTitle(`🎫 تذكرة • ${labels[type]}`)
        .setDescription(
          `أهلاً ${interaction.user} 👋\n\n` +
          '> سيقوم فريق الدعم بالرد عليك في أقرب وقت.\n' +
          '> اشرح مشكلتك بالتفصيل من فضلك.\n\n' +
          '⚠️ اضغط على الزر بالأسفل لإغلاق التذكرة.'
        )
        .setTimestamp();

      const buttons = new ActionRowBuilder().addComponents(
        new ButtonBuilder().setCustomId('ticket_close').setLabel('إغلاق التذكرة').setEmoji('🔒').setStyle(ButtonStyle.Danger),
        new ButtonBuilder().setCustomId('ticket_claim').setLabel('استلام').setEmoji('✋').setStyle(ButtonStyle.Primary),
      );

      await channel.send({ content: `${interaction.user}`, embeds: [welcome], components: [buttons] });
      await interaction.reply({ content: `✅ تم إنشاء تذكرتك: ${channel}`, ephemeral: true });
    }

    if (interaction.isButton() && interaction.customId === 'ticket_close') {
      await interaction.reply({ content: '🔒 سيتم إغلاق التذكرة خلال 5 ثواني...' });
      setTimeout(() => interaction.channel.delete().catch(() => {}), 5000);
    }

    if (interaction.isButton() && interaction.customId === 'ticket_claim') {
      const embed = new EmbedBuilder()
        .setColor(0xFEE75C)
        .setDescription(`✋ تم استلام التذكرة بواسطة ${interaction.user}`);
      await interaction.reply({ embeds: [embed] });
    }
  },
};
