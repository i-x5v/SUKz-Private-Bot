const { SlashCommandBuilder, EmbedBuilder } = require('discord.js');

module.exports = {
  data: new SlashCommandBuilder()
    .setName('chat')
    .setDescription('تحدث مع الذكاء الاصطناعي')
    .addStringOption(opt =>
      opt.setName('message').setDescription('رسالتك').setRequired(true).setMaxLength(1000)),

  async execute(interaction) {
    const message = interaction.options.getString('message');
    await interaction.deferReply();

    try {
      const res = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'gpt-4o-mini',
          messages: [
            { role: 'system', content: 'أنت مساعد ذكي ودود تتحدث العربية بطلاقة. أجب باختصار ووضوح.' },
            { role: 'user', content: message },
          ],
          max_tokens: 500,
        }),
      });

      if (!res.ok) throw new Error(`API error ${res.status}`);
      const data = await res.json();
      const reply = data.choices[0].message.content;

      const embed = new EmbedBuilder()
        .setColor(0x5865F2)
        .setAuthor({ name: interaction.user.username, iconURL: interaction.user.displayAvatarURL() })
        .addFields(
          { name: '💭 سؤالك', value: message },
          { name: '🤖 الإجابة', value: reply.slice(0, 1024) },
        )
        .setFooter({ text: 'Powered by AI' })
        .setTimestamp();

      await interaction.editReply({ embeds: [embed] });
    } catch (err) {
      console.error(err);
      await interaction.editReply('❌ حصل خطأ، حاول لاحقاً.');
    }
  },
};require('dotenv').config();
const fs = require('fs');
const path = require('path');
const { Client, Collection, GatewayIntentBits, REST, Routes } = require('discord.js');

const client = new Client({
  intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages, GatewayIntentBits.MessageContent],
});

client.commands = new Collection();
const commandsData = [];

const commandsPath = path.join(__dirname, 'commands');
for (const file of fs.readdirSync(commandsPath).filter(f => f.endsWith('.js'))) {
  const command = require(path.join(commandsPath, file));
  client.commands.set(command.data.name, command);
  commandsData.push(command.data.toJSON());
}

client.once('ready', async () => {
  console.log(`✅ ${client.user.tag} يعمل الآن`);
  const rest = new REST({ version: '10' }).setToken(process.env.TOKEN);MTQ3NjQyMDE3MDMzMDI3NTg2MA.G0d4yQ.5JtkokAqHhJidH1P5vf8sxpjW2fEdS5eLrO8G4
  await rest.put(Routes.applicationCommands(client.user.id), { body: commandsData });
  console.log('✅ تم تسجيل الأوامر');
});

client.on('interactionCreate', async (interaction) => {
  if (interaction.isChatInputCommand()) {
    const command = client.commands.get(interaction.commandName);
    if (command) {
      try { await command.execute(interaction); }
      catch (e) { console.error(e); }
    }
    return;
  }

  const ticket = client.commands.get('ticket');
  if (ticket?.handleInteraction) await ticket.handleInteraction(interaction);
});

